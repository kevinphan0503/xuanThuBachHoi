# Copy this file to .env and fill values

# Option A: Use Render External DB URL (for local dev or non-Render backend)
# Set DB_SSL=true when using External URL
# DATABASE_URL=postgresql://boardgame_festival_qxw0_user:YOUR_PASSWORD@dpg-d5jcbri4d50c73fqe31g-a.singapore-postgres.render.com/boardgame_festival_qxw0
# DB_SSL=true

# Option B: Use Render Internal DB URL (when backend runs on Render)
# Set DB_SSL=false for Internal URL
# DATABASE_URL=postgresql://boardgame_festival_qxw0_user:YOUR_PASSWORD@dpg-d5jcbri4d50c73fqe31g-a/boardgame_festival_qxw0
# DB_SSL=false

# Option C: Discrete fields (local Postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=123456
# DB_NAME=boardgame_festival

# API server port
API_PORT=5000

# Frontend API base
# Local dev:
VITE_API_URL=http://localhost:5001
# Deployed (example):
# VITE_API_URL=https://your-render-api.onrender.com
